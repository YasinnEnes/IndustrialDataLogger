# ==============================================================================
# IndustrialDataLogger - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your production or local secrets.
# NEVER commit the '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=IndustrialDataDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_1234
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=IndustrialDataDB;Username=postgres;Password=postgres_secure_password_1234

# ------------------------------------------------------------------------------
# 2. Security & Authentication (JWT Bearer)
# ------------------------------------------------------------------------------
# Minimum 32 characters, cryptographically strong key
JWT_SECRET=IndustrialDataLogger_SuperSecret_Jwt_Key_2026_Production_Secure_Key_998877665544

# ------------------------------------------------------------------------------
# 3. Industrial Hardware Communication (Siemens S7-1200 PLC)
# ------------------------------------------------------------------------------
PLC_IP_ADDRESS=192.168.0.1
PLC_RACK=0
PLC_SLOT=1

# ------------------------------------------------------------------------------
# 4. Web Application & Runtime
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
