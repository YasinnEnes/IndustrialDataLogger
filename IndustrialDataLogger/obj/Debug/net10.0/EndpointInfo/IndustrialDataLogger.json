              "schema": {
                "$ref": "#/components/schemas/ModeModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ModeModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
