        "type": "object",
        "properties": {
          "isSimulation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PlcWriteRequest": {
        "type": "object",
        "properties": {
          "variableName": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
